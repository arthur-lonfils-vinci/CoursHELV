# ----- WISHLIST UTILISATEURS (Sets) -----
SADD wishlist:user:1 "product:104" "product:110"
SADD wishlist:user:2 "product:101" "product:103" "product:108"
SADD wishlist:user:3 "product:105" "product:106"
SADD wishlist:user:6 "product:101" "product:104" "product:102"
SADD wishlist:user:9 "product:108" "product:109"

# ----- SESSIONS ACTIVES (Strings avec TTL simulé) -----
SET session:user:1 "token_a1b2c3d4" 
SET session:user:3 "token_e5f6g7h8"
SET session:user:5 "token_i9j0k1l2"
SET session:user:10 "token_m3n4o5p6"

# ----- STATISTIQUES GLOBALES -----
SET stats:total_users 10
SET stats:total_products 10
SET stats:total_orders 8
SET stats:revenue_total 498432

# ----- ACTIVITÉ RÉCENTE (List) -----
LPUSH activity:feed "user:1 viewed product:101" "user:3 added product:104 to cart" "user:2 purchased order:1003" "user:5 reviewed product:108" "user:1 added product:103 to wishlist" "user:7 signed up" "user:10 viewed product:105" "user:4 purchased order:1007"

# ----- AVIS PRODUITS (Sorted Set - score = note) -----
